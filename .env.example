# ---- Mode -------------------------------------------------------------
# mock = standalone sample catalogue & simulated orders; live = real Sapo
COMMERCE_MODE=mock
# (trống) = nội dung thật của OVIAN trong src/lib/cms/ovian-content.ts; sanity = Sanity CMS; sample = nội dung mẫu, chỉ dùng cho test
CONTENT_MODE=
# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Sapo (server-only, never NEXT_PUBLIC_) ---------------------------
SAPO_STORE_DOMAIN=your-store.mysapo.net
# Either an OAuth/private-app access token ...
SAPO_ACCESS_TOKEN=
# ... or private app API key + secret (HTTP Basic)
SAPO_API_KEY=
SAPO_API_SECRET=
# Shared secret used to verify Sapo webhooks
SAPO_WEBHOOK_SECRET=
# Must be "true" before the storefront may POST real orders to Sapo
SAPO_ALLOW_ORDER_WRITES=false

# ---- Sanity ------------------------------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Optional read token (only for private datasets / drafts)
SANITY_READ_TOKEN=
# Secret for /api/revalidate (Sanity webhook)
REVALIDATE_SECRET=

# ---- Checkout ----------------------------------------------------------
# Durable idempotency store (JSON file). Mount a volume here in Docker.
IDEMPOTENCY_STORE_PATH=.data/idempotency.json

# ---- Testing only ------------------------------------------------------
# Enables /api/__mock/control (mock mode only, ignored when NODE_ENV=production unless set)
MOCK_CONTROL=false

# ---- Orders → Google Sheet (Apps Script web app) ----
# Where orders go. Empty = automatic: simulated orders in Mock Mode, Google Sheet in live mode. Or: sheets | sapo
ORDER_BACKEND=
# Checkout stays disabled until this is true AND the two values below are set.
ORDERS_ENABLED=false
# Web app URL from Apps Script "Deploy → New deployment" (ends with /exec). Server-side only.
GOOGLE_SHEETS_WEBAPP_URL=
# Long random secret (32+ chars). Same value as the OVIAN_SECRET script property. Never commit it.
GOOGLE_SHEETS_SECRET=

# ---- Which Sapo products appear on the site ----
# true = every active product (store without the Sapo website plan). false = only products published to the Sapo web channel.
SAPO_LIST_UNPUBLISHED=true
# Products with this tag in Sapo are hidden from the website.
WEB_HIDE_TAG=an-web

# ---- Delivery methods ----
# Store pickup (cash at the store). OVIAN offers home delivery (COD) only, so this stays false.
STORE_PICKUP_ENABLED=false

# ---- Anti-spam (order form) ----
# Signs the hidden form token. Set this in production so tokens survive a restart or a second
# instance; without it the server picks a random one each start. Any long random string.
ORDER_TOKEN_SECRET=
# An order above either limit is refused online and the customer is asked to contact OVIAN.
MAX_ORDER_TOTAL=5000000
MAX_ORDER_ITEMS=20
